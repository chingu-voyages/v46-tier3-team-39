{
  "name": "study-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "secrets": "npx ts-node ./generateEnv.ts",
    "dev": "next dev",
    "build": "npm run prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma": "dotenv -e .env.local -- npx prisma generate --schema=./backend/prisma/schema.prisma && npm run createSchema && npm run compileGql",
    "createSchema": "npx ts-node ./src/gql/createSchema.ts",
    "seed": "npx ts-node ./src/app/util/prisma/seed.ts",
    "compileGql": "graphql-codegen",
    "watchGql": "graphql-codegen -w",
    "analyze": "npx cross-env ANALYZE=true next build",
    "prisma:push": "dotenv -e .env.local -- npx prisma db push --schema=./backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@apollo/client": "3.8.8",
    "@apollo/server": "4.9.5",
    "@as-integrations/next": "3.0.0",
    "@emotion/react": "11.11.3",
    "@emotion/styled": "11.11.0",
    "@fortawesome/fontawesome-svg-core": "6.5.1",
    "@fortawesome/free-brands-svg-icons": "6.5.1",
    "@fortawesome/free-regular-svg-icons": "6.5.1",
    "@fortawesome/free-solid-svg-icons": "6.5.1",
    "@fortawesome/react-fontawesome": "0.2.0",
    "@mui/icons-material": "5.15.3",
    "@mui/material": "5.15.3",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "5.7.1",
    "axios": "1.7.7",
    "bcryptjs": "2.4.3",
    "bson-objectid": "2.0.4",
    "class-validator": "0.14.0",
    "date-fns": "3.0.6",
    "graphql": "16.8.1",
    "graphql-fields": "2.0.3",
    "graphql-scalars": "1.22.4",
    "graphql-tag": "2.12.6",
    "lodash": "4.17.21",
    "next": "14.2.16",
    "next-auth": "4.24.8",
    "openai": "4.24.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "4.12.0",
    "react-infinite-scroll-component": "6.1.0",
    "react-lines-ellipsis": "0.15.4",
    "react-select": "5.8.0",
    "react-sweet-state": "2.7.1",
    "reflect-metadata": "0.2.1",
    "swiper": "11.0.5",
    "uuid": "9.0.1",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "dotenv-cli": "7.3.0",
    "@fullhuman/postcss-purgecss": "5.0.0",
    "@graphql-codegen/cli": "5.0.0",
    "@graphql-codegen/client-preset": "4.1.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@next/bundle-analyzer": "14.0.4",
    "@parcel/watcher": "2.3.0",
    "@types/bcryptjs": "2.4.6",
    "@types/graphql-fields": "1.3.8",
    "@types/lodash": "4.14.202",
    "@types/node": "20.10.6",
    "@types/react": "18.2.46",
    "@types/react-dom": "18.2.18",
    "@types/react-lines-ellipsis": "0.15.5",
    "@types/react-paginate": "7.1.4",
    "@types/uuid": "9.0.7",
    "autoprefixer": "10.4.16",
    "bson": "6.2.0",
    "cross-env": "7.0.3",
    "encoding": "0.1.13",
    "eslint": "8.56.0",
    "eslint-config-next": "14.0.4",
    "postcss": "8.4.32",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-normalize": "10.0.1",
    "postcss-preset-env": "9.3.0",
    "tailwindcss": "3.4.0",
    "ts-node": "10.9.2",
    "tslib": "2.6.2",
    "type-graphql": "2.0.0-beta.3",
    "typegraphql-prisma": "0.27.1",
    "typescript": "5.3.3"
  }
